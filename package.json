{
  "name": "reponpc-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "web:format": "pnpm --dir apps/web run format",
    "web:lint": "pnpm --dir apps/web run lint",
    "web:typecheck": "pnpm --dir apps/web run typecheck",
    "web:test": "pnpm --dir apps/web run test",
    "web:build": "pnpm --dir apps/web run build",
    "web:check": "pnpm run web:format && pnpm run web:lint && pnpm run web:typecheck && pnpm run web:test && pnpm run web:build"
  }
}
