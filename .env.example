# RepoNPC deployment environment example.
# Copy to .env for local evaluation or, preferably, provide production secrets
# through Docker/Kubernetes secret files. Never commit the populated file.
# 0.2.2: chat and embedding are independent and remain unconfigured until the
# owner explicitly selects a service in the protected model setup flow.

# Application and public origin
REPONPC_ENV=production
# Controls admin access and exposure expectations. loopback_evaluation uses a
# passwordless, one-use launcher grant and is valid only for a direct loopback
# bind with no trusted proxy. production uses setup-code + a 15-character
# minimum password, including when the browser connects through SSH/VPN.
REPONPC_DEPLOYMENT_PROFILE=production
REPONPC_PUBLIC_BASE_URL=https://portfolio.example.com
REPONPC_HOST=0.0.0.0
REPONPC_PORT=8000
REPONPC_DATA_DIR=/var/lib/reponpc
REPONPC_LOG_LEVEL=INFO
REPONPC_TRUSTED_HOSTS=portfolio.example.com
# Empty means same-origin only. Do not use * with admin cookies.
REPONPC_ALLOWED_ORIGINS=
# Configure only when a trusted reverse proxy sets client IP headers.
REPONPC_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Configuration repository and immutable bundle discovery
REPONPC_CONFIG_REPOSITORY=your-github-name/your-github-name
REPONPC_CONFIG_BRANCH=main
REPONPC_CONFIG_PATH=reponpc.yml
REPONPC_INDEX_MANIFEST_URL=https://raw.githubusercontent.com/your-github-name/your-github-name/reponpc-index/stable-manifest.json
REPONPC_INDEX_POLL_SECONDS=300
REPONPC_MAX_BUNDLE_BYTES=536870912
REPONPC_KEEP_VALID_BUNDLES=2

# GitHub admin writeback and workflow dispatch (server-side secret)
# Prefer REPONPC_GITHUB_TOKEN_FILE in production. Set only one of TOKEN/TOKEN_FILE.
REPONPC_GITHUB_TOKEN=
# REPONPC_GITHUB_TOKEN_FILE=/run/secrets/reponpc_github_token
REPONPC_GITHUB_TOKEN_FILE=
REPONPC_GITHUB_API_URL=https://api.github.com
REPONPC_INDEX_WORKFLOW=build-index.yml

# LEGACY 0.2.0 ONLY — ignored by 0.2.1 compatibility loading. Do not configure.
# Legacy authenticated-encryption key for OAuth/PAT runtime records.
# The 0.2.1 target accepts no OAuth or browser-entered public-read PAT.

# Chat provider: ollama, openai_compatible, or the vllm preset.
# vllm uses the OpenAI-compatible transport and may use a private HTTP origin.
REPONPC_CHAT_PROVIDER=
REPONPC_CHAT_MODEL=
REPONPC_CHAT_BASE_URL=
REPONPC_CHAT_API_KEY=
REPONPC_CHAT_API_KEY_FILE=
REPONPC_CHAT_MAX_CONTEXT_TOKENS=32768
REPONPC_CHAT_MAX_OUTPUT_TOKENS=4096
REPONPC_CHAT_TIMEOUT_SECONDS=45

# Authenticated repository analysis output; independent of visitor chat/probes.
# Positive integer, default 8192, hard maximum 16384 (16k).
# Prompt/evidence/schema plus reserved output must fit the model context above.
REPONPC_ANALYSIS_MAX_OUTPUT_TOKENS=8192
# Flexible analysis budgets. Semaphore/rate-limit waiting does not spend the
# repository execution budget. Provider timeout is a per-operation inactivity
# ceiling; non-streaming providers cannot expose first-token progress.
REPONPC_ANALYSIS_REPOSITORY_TIMEOUT_SECONDS=1800
REPONPC_ANALYSIS_PROVIDER_TIMEOUT_SECONDS=300
REPONPC_ANALYSIS_GENERATION_ATTEMPTS=3
REPONPC_ANALYSIS_GITHUB_TIMEOUT_SECONDS=60
REPONPC_ANALYSIS_ARCHIVE_MAX_COMPRESSED_BYTES=268435456
REPONPC_ANALYSIS_ARCHIVE_MAX_UNCOMPRESSED_BYTES=1073741824
REPONPC_ANALYSIS_ARCHIVE_MAX_ENTRIES=100000
# Files over this materialization limit are skipped and reported, not fatal.
REPONPC_ANALYSIS_ARCHIVE_MAX_SINGLE_FILE_BYTES=2097152
REPONPC_ANALYSIS_MAX_FILE_BYTES=2097152
REPONPC_ANALYSIS_MAX_REPOSITORY_TEXT_BYTES=104857600
REPONPC_ANALYSIS_MAX_CORPUS_TEXT_BYTES=262144000

# To use an OpenAI-compatible chat service, for example:
# REPONPC_CHAT_PROVIDER=openai_compatible
# REPONPC_CHAT_BASE_URL=https://api.example.com/v1
# REPONPC_CHAT_MODEL=your-chat-model
# REPONPC_CHAT_API_KEY_FILE=/run/secrets/reponpc_chat_api_key

# To use a private vLLM OpenAI-compatible server, for example:
# REPONPC_CHAT_PROVIDER=vllm
# REPONPC_CHAT_BASE_URL=http://vllm:8000/v1
# REPONPC_CHAT_MODEL=your-served-chat-model
# REPONPC_CHAT_API_KEY_FILE=/run/secrets/reponpc_chat_api_key

# Embedding provider must exactly match the active bundle manifest after an
# explicit probe/reindex. Choose ollama, openai_compatible, or vllm.
REPONPC_EMBEDDING_PROVIDER=
REPONPC_EMBEDDING_MODEL=
REPONPC_EMBEDDING_DIMENSION=1024
REPONPC_EMBEDDING_NORMALIZED=true
REPONPC_EMBEDDING_BASE_URL=
REPONPC_EMBEDDING_API_KEY=
REPONPC_EMBEDDING_API_KEY_FILE=

# To use an OpenAI-compatible embedding service, for example:
# REPONPC_EMBEDDING_PROVIDER=openai_compatible
# REPONPC_EMBEDDING_BASE_URL=https://api.example.com/v1
# REPONPC_EMBEDDING_MODEL=your-embedding-model
# REPONPC_EMBEDDING_API_KEY_FILE=/run/secrets/reponpc_embedding_api_key

# To use another Ollama embedding model, for example:
# REPONPC_EMBEDDING_PROVIDER=ollama
# REPONPC_EMBEDDING_BASE_URL=http://ollama:11434
# REPONPC_EMBEDDING_MODEL=bge-m3

# A vLLM embedding endpoint normally serves a pooling/embedding model and may
# be a different instance from the chat server:
# REPONPC_EMBEDDING_PROVIDER=vllm
# REPONPC_EMBEDDING_BASE_URL=http://vllm-embedding:8000/v1
# REPONPC_EMBEDDING_MODEL=your-served-embedding-model
# REPONPC_EMBEDDING_API_KEY_FILE=/run/secrets/reponpc_embedding_api_key

# Production single-owner authentication. Leave both blank for production
# first-owner setup, then run: docker compose exec app reponpc admin setup-code
# loopback_evaluation ignores this form and uses the local launcher grant.
# Optional production pre-provisioning: set BOTH username and the output of
# `reponpc admin hash-password`; doing so disables first-owner setup.
REPONPC_ADMIN_USERNAME=
REPONPC_ADMIN_PASSWORD_HASH=
REPONPC_ADMIN_IDLE_MINUTES=30
REPONPC_ADMIN_ABSOLUTE_HOURS=12
# Generate at least 32 random bytes; used to HMAC pseudonymous IP rate keys.
# Prefer the secret file in production. Set only one of HASH_KEY/HASH_KEY_FILE.
REPONPC_IP_HASH_KEY=
REPONPC_IP_HASH_KEY_FILE=/run/secrets/reponpc_ip_hash_key

# Public abuse and cost controls
REPONPC_RATE_LIMIT_REQUESTS_PER_MINUTE=10
REPONPC_GLOBAL_CHAT_CONCURRENCY=2
REPONPC_DAILY_CHAT_REQUEST_BUDGET=200
REPONPC_MAX_MESSAGE_CHARACTERS=2000
REPONPC_MAX_HISTORY_MESSAGES=6
REPONPC_MAX_HISTORY_CHARACTERS=6000
# Optional display-only estimate for admin usage reporting; blank disables cost estimate.
REPONPC_INPUT_COST_PER_MILLION_TOKENS=
REPONPC_OUTPUT_COST_PER_MILLION_TOKENS=

# Runtime and operational behavior
REPONPC_SQLITE_BUSY_TIMEOUT_MS=5000
REPONPC_PROVIDER_HEALTH_SECONDS=60
REPONPC_SSE_KEEPALIVE_SECONDS=15
REPONPC_SHUTDOWN_GRACE_SECONDS=30
# Raw chat/prompt persistence stays disabled in v1. This variable is explicit so
# an operator can verify the privacy posture; true is not supported by v1.
REPONPC_PERSIST_CONVERSATIONS=false
