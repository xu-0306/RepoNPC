+from __future__ import annotations
+
+import sys
+from types import ModuleType
+from typing import Any
+
+import numpy as np
+import pytest
+
+from reponpc.indexing.sources import EmbeddingProviderError
+from reponpc.providers.local_sentence_transformers import (
+    LocalSentenceTransformersEmbeddingProvider,
+)
+
+
+class FakeModel:
+    def __init__(self, output: np.ndarray | Exception) -> None:
+        self.output = output
+        self.calls: list[tuple[list[str], dict[str, Any]]] = []
+
+    def encode(self, texts: list[str], **kwargs: Any) -> np.ndarray:
+        self.calls.append((texts, kwargs))
+        if isinstance(self.output, Exception):
+            raise self.output
+        return self.output
+
+
+def install_fake_module(monkeypatch: pytest.MonkeyPatch, model: FakeModel | Exception) -> None:
+    module = ModuleType("sentence_transformers")
+
+    def sentence_transformer(*args: Any, **kwargs: Any) -> FakeModel:
+        if isinstance(model, Exception):
+            raise model
+        model.constructor_args = args  # type: ignore[attr-defined]
+        model.constructor_kwargs = kwargs  # type: ignore[attr-defined]
+        return model
+
+    module.SentenceTransformer = sentence_transformer  # type: ignore[attr-defined]
+    monkeypatch.setitem(sys.modules, "sentence_transformers", module)
+
+
+def provider(**overrides: Any) -> LocalSentenceTransformersEmbeddingProvider:
+    values = {
+        "model_id": "intfloat/multilingual-e5-small",
+        "dimension": 2,
+        "normalized": True,
+        "query_prefix": "query: ",
+        "passage_prefix": "passage: ",
+    }
+    values.update(overrides)
+    return LocalSentenceTransformersEmbeddingProvider(**values)
+
+
+def normalized_output() -> np.ndarray:
+    return np.array([[0.6, 0.8]], dtype=np.float32)
+
+
+def test_identity_and_exact_prefixes_encode_options_and_one_model_load(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    model = FakeModel(normalized_output())
+    install_fake_module(monkeypatch, model)
+    subject = provider(device="cuda:0", batch_size=7)
+
+    assert subject.identity().adapter == "local_sentence_transformers"
+    assert subject.identity().model_id == "intfloat/multilingual-e5-small"
+    assert subject.identity().dimension == 2
+    assert subject.identity().normalized is True
+    assert subject.embed_query(["hello"]).dtype == np.float32
+    assert subject.embed_passages(["world"]).shape == (1, 2)
+    assert model.constructor_args == ("intfloat/multilingual-e5-small",)  # type: ignore[attr-defined]
+    assert model.constructor_kwargs == {  # type: ignore[attr-defined]
+        "device": "cuda:0",
+        "trust_remote_code": False,
+    }
+    assert model.calls == [
+        (
+            ["query: hello"],
+            {
+                "batch_size": 7,
+                "convert_to_numpy": True,
+                "normalize_embeddings": True,
+                "show_progress_bar": False,
+            },
+        ),
+        (
+            ["passage: world"],
+            {
+                "batch_size": 7,
+                "convert_to_numpy": True,
+                "normalize_embeddings": True,
+                "show_progress_bar": False,
+            },
+        ),
+    ]
+
+
+def test_empty_input_needs_no_optional_dependency(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setitem(sys.modules, "sentence_transformers", None)
+
+    result = provider().embed_query([])
+
+    assert result.shape == (0, 2)
+    assert result.dtype == np.float32
+
+
+@pytest.mark.parametrize(
+    ("name", "value"),
+    [
+        ("model_id", ""),
+        ("dimension", 0),
+        ("dimension", True),
+        ("normalized", False),
+        ("query_prefix", ""),
+        ("passage_prefix", ""),
+        ("device", ""),
+        ("batch_size", 0),
+        ("batch_size", True),
+    ],
+)
+def test_constructor_rejects_invalid_contract_values(name: str, value: Any) -> None:
+    with pytest.raises(ValueError):
+        provider(**{name: value})
+
+
+@pytest.mark.parametrize(
+    ("installed", "expected_code"),
+    [
+        (None, "embedding_dependency_unavailable"),
+        (RuntimeError("model path /sensitive"), "embedding_model_load_failed"),
+    ],
+)
+def test_safe_dependency_and_model_load_errors(
+    monkeypatch: pytest.MonkeyPatch, installed: Exception | None, expected_code: str
+) -> None:
+    if installed is None:
+        monkeypatch.setitem(sys.modules, "sentence_transformers", None)
+    else:
+        install_fake_module(monkeypatch, installed)
+
+    with pytest.raises(EmbeddingProviderError) as raised:
+        provider().embed_query(["x"])
+
+    assert raised.value.code == expected_code
+    assert str(raised.value) == "embedding provider failed"
+    assert "sensitive" not in str(raised.value)
+
+
+def test_encode_error_is_safe_and_does_not_fallback(monkeypatch: pytest.MonkeyPatch) -> None:
+    model = FakeModel(RuntimeError("upstream model path /sensitive"))
+    install_fake_module(monkeypatch, model)
+
+    with pytest.raises(EmbeddingProviderError) as raised:
+        provider().embed_query(["x"])
+
+    assert raised.value.code == "embedding_encode_failed"
+    assert str(raised.value) == "embedding provider failed"
+    assert len(model.calls) == 1
+
+
+@pytest.mark.parametrize(
+    "output",
+    [
+        np.array([0.6, 0.8], dtype=np.float32),
+        np.array([[0.6, 0.8, 0.0]], dtype=np.float32),
+        np.array([[0.6, 0.8]], dtype=np.float64),
+        np.array([[np.nan, 0.8]], dtype=np.float32),
+        np.array([[0.0, 0.0]], dtype=np.float32),
+        np.array([[0.5, 0.5]], dtype=np.float32),
+    ],
+)
+def test_invalid_output_is_rejected_without_upstream_text(
+    monkeypatch: pytest.MonkeyPatch, output: np.ndarray
+) -> None:
+    install_fake_module(monkeypatch, FakeModel(output))
+
+    with pytest.raises(EmbeddingProviderError) as raised:
+        provider().embed_query(["x"])
+
+    assert raised.value.code == "embedding_output_invalid"
+    assert str(raised.value) == "embedding provider failed"
